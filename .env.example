# Copie para .env.local (desenvolvimento) ou configure no provedor de hospedagem.
# Use SOMENTE a chave pública (anon). Nunca coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON
# URL final do site (sitemap, canonical, compartilhamento)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
# Texto aleatório longo, usado para gerar o hash do IP no anti-spam (apenas servidor)
IP_HASH_SALT=troque-por-um-texto-aleatorio-longo
